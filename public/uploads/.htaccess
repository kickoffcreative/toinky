Options -Indexes -ExecCGI -Includes
RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .cgi .pl .py .sh .shtml
<FilesMatch ".*">
    SetHandler none
</FilesMatch>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
Require all denied
<FilesMatch "(?i)\.(?:jpe?g|png|webp)$">
    Require all granted
</FilesMatch>
